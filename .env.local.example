# ---------------------------------------------------------------------------
# Sanity — powers the admin panel at /studio
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored and must never be committed.
#
# Where to get these:
#   1. Sign up free at https://www.sanity.io/  →  Create new project
#   2. Project ID is shown on the project dashboard, and under Manage → API
#   3. Dataset is "production" unless you deliberately made another one
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional. Pins the Sanity API version; leave as-is unless you know why.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---------------------------------------------------------------------------
# Write token — ONLY needed to run `npm run seed` once, and only on your own
# machine. Do not add this to Vercel: the website never writes to Sanity.
#
# Create at: sanity.io/manage → your project → API → Tokens → Add API token
#            Name: "seed script", Permissions: Editor
# ---------------------------------------------------------------------------

SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Webhook secret — makes published changes appear on the live site instantly
# instead of within 60 seconds. Optional; see README for the webhook setup.
# Use any long random string, and paste the same value into the Sanity webhook.
# ---------------------------------------------------------------------------

SANITY_REVALIDATE_SECRET=
